<idea-plugin>
    <id>com.wcdk.r2dbc.idea</id>
    <name>WCDK R2DBC Support</name>
    <version>0.1.0</version>
    <vendor email="support@wcdk.com" url="https://github.com/wcdk">WCDK</vendor>
    <logo>icons/wcdk-logo.png</logo>
    <description><![CDATA[
        WCDK-R2DBC 辅助插件
        WCDK R2DBC Support provides navigation and editor assistance for WCDK R2DBC XML repositories.
        It links repository namespaces, statement IDs, result types, and SQL properties to their related
        Java repository and domain classes.
    ]]></description>

    <idea-version since-build="243"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileIconProvider implementation="com.wcdk.r2dbc.idea.WcdkFileIconProvider"/>
        <psi.referenceContributor language="XML" implementation="com.wcdk.r2dbc.idea.reference.WcdkXmlReferenceContributor"/>
        <codeInsight.lineMarkerProvider language="XML" implementationClass="com.wcdk.r2dbc.idea.marker.WcdkLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA" implementationClass="com.wcdk.r2dbc.idea.marker.WcdkLineMarkerProvider"/>
    </extensions>
</idea-plugin>
